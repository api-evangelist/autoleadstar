        {
          "info": {
            "name": "Get a single audience",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://fullpath.com/api/v2/external/consent-management/dealerships/:dealershipId/audiences/:id",
            "params": [
              {
                "name": "dealershipId",
                "value": "",
                "type": "path",
                "description": "Dealership identifier (integer)"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Audience identifier (integer)"
              },
              {
                "name": "embed",
                "value": "shoppers_count",
                "type": "query",
                "description": "Comma-separated list of fields to embed in the response. Available options:\nshoppers_count\n"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves an audience by `id`.\n\nAdditional fields can be included in the response using the `embed` parameter. Available embed options:\n- `shoppers_count`: Include the count of shoppers in the audience\n"
        },
