{
  "opencollection": "1.0.0",
  "info": {
    "name": "Autoleadstar Audiences API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "audiences",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List audiences for a shopper",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://fullpath.com/api/v2/external/consent-management/dealerships/:dealershipId/shoppers/:id/audiences",
            "params": [
              {
                "name": "dealershipId",
                "value": "",
                "type": "path",
                "description": "Dealership identifier (integer)"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Shopper identifier (integer)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort order (comma-separated field names with optional - prefix for descending)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a paginated list of audiences associated with the shopper"
        },
        {
          "info": {
            "name": "List audiences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://fullpath.com/api/v2/external/consent-management/dealerships/:dealershipId/audiences",
            "params": [
